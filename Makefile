#compiler settings
CXX = g++ -g -fsanitize=address
CXXFLAGS = -std=c++17 -Wall -Wextra -I$(INCLUDE_DIR) -MMD -MP

#path variables
APPS_DIR = ./apps
BIN_DIR = ./bin
BUILD_DIR = ./build
DATA_DIR = ./data
INCLUDE_DIR = ./include
SCRIPTS_DIR =./scripts
SRC_DIR = ./src

MAIN_HORIZONTAL_SRC = $(APPS_DIR)/Horizontal_movement.cpp
MAIN_CIRCULAR_SRC = $(APPS_DIR)/Circular_movement.cpp



ACCELERATION_SRC = $(SRC_DIR)/Acceleration.cpp
ACCELERATION_HEADER = $(INCLUDE_DIR)/Acceleration.h

DISTANCE_SRC = $(SRC_DIR)/Distance.cpp
DISTANCE_HEADER = $(INCLUDE_DIR)/Distance.h

IO_UTILS_SRC = $(SRC_DIR)/io_utils.cpp
IO_UTILS_HEADER = $(INCLUDE_DIR)/io_utils.h

MICROPHONE_SRC = $(SRC_DIR)/Microphone.cpp
MICROPHONE_HEADER = $(INCLUDE_DIR)/Microphone.h

PHYSICAl_OBJECT_SRC = $(SRC_DIR)/PhysicalObject.cpp
PHYSICAL_OBJECT_HEADER = $(INCLUDE_DIR)/PhysicalObject.h

SOURCE_SRC = $(SRC_DIR)/Source.cpp
SOURCE_HEADER = $(INCLUDE_DIR)/Source.h

VELOCITY_SRC = $(SRC_DIR)/Velocity.cpp
VELOCITY_HEADER = $(INCLUDE_DIR)/Velocity.h

POSITION_HEADER = $(INCLUDE_DIR)/Position.h

POSITION_GENERATOR_SRC = $(SRC_DIR)/Position_generator.cpp
POSITION_GENERATOR_HEADER = $(INCLUDE_DIR)/Position_generator.h

#object files
MAIN_HORIZONTAL_OBJ = $(BUILD_DIR)/Horizontal_movement.o
MAIN_CIRCULAR_OBJ = $(BUILD_DIR)/Circular_movement.o
ACCELERATION_OBJ = $(BUILD_DIR)/Acceleration.o
DISTANCE_OBJ     = $(BUILD_DIR)/Distance.o
IO_UTILS_OBJ     = $(BUILD_DIR)/io_utils.o
MICROPHONE_OBJ  = $(BUILD_DIR)/Microphone.o
PHYSICAL_OBJECT_OBJ = $(BUILD_DIR)/PhysicalObject.o
SOURCE_OBJ       = $(BUILD_DIR)/Source.o
VELOCITY_OBJ     = $(BUILD_DIR)/Velocity.o

#TESTE:
POSITION_GENERATOR_OBJ = $(BUILD_DIR)/Position_generator.o

MAIN_OBJS = $(MAIN_HORIZONTAL_OBJ) $(MAIN_CIRCULAR_OBJ)

COMMON_OBJS = $(ACCELERATION_OBJ) $(DISTANCE_OBJ) $(IO_UTILS_OBJ) $(MICROPHONE_OBJ) \
              $(PHYSICAL_OBJECT_OBJ) $(SOURCE_OBJ) $(VELOCITY_OBJ) $(POSITION_GENERATOR_OBJ)


#final executables
BIN_HORIZONTAL = $(BIN_DIR)/Horizontal_movement
BIN_CIRCULAR = $(BIN_DIR)/Circular_movement



ALL_BINS = $(BIN_HORIZONTAL) $(BIN_CIRCULAR)



#Targets and dependencies
all: $(ALL_BINS)

#create the output folders if they don't exist yet
$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(BIN_DIR):
	mkdir -p $(BIN_DIR)

#link step
$(BIN_HORIZONTAL): $(MAIN_HORIZONTAL_OBJ) $(COMMON_OBJS) | $(BIN_DIR)
	$(CXX) $(MAIN_HORIZONTAL_OBJ) $(COMMON_OBJS) -o $(BIN_HORIZONTAL)

$(BIN_CIRCULAR): $(MAIN_CIRCULAR_OBJ) $(COMMON_OBJS) | $(BIN_DIR)
	$(CXX) $(MAIN_CIRCULAR_OBJ) $(COMMON_OBJS) -o $(BIN_CIRCULAR)

#compile steps

$(VELOCITY_OBJ): $(VELOCITY_SRC) $(VELOCITY_HEADER) | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $(VELOCITY_SRC) -o $(VELOCITY_OBJ)

$(SOURCE_OBJ): $(SOURCE_SRC) $(SOURCE_HEADER) | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $(SOURCE_SRC) -o $(SOURCE_OBJ)

$(PHYSICAL_OBJECT_OBJ): $(PHYSICAl_OBJECT_SRC) $(PHYSICAL_OBJECT_HEADER) | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $(PHYSICAl_OBJECT_SRC) -o $(PHYSICAL_OBJECT_OBJ)

$(MICROPHONE_OBJ): $(MICROPHONE_SRC) $(MICROPHONE_HEADER) | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $(MICROPHONE_SRC) -o $(MICROPHONE_OBJ)

$(IO_UTILS_OBJ): $(IO_UTILS_SRC) $(IO_UTILS_HEADER) | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $(IO_UTILS_SRC) -o $(IO_UTILS_OBJ)

$(DISTANCE_OBJ): $(DISTANCE_SRC) $(DISTANCE_HEADER) | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $(DISTANCE_SRC) -o $(DISTANCE_OBJ)

$(ACCELERATION_OBJ): $(ACCELERATION_SRC) $(ACCELERATION_HEADER) | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $(ACCELERATION_SRC) -o $(ACCELERATION_OBJ)

#TESTE:
$(POSITION_GENERATOR_OBJ): $(POSITION_GENERATOR_SRC) $(POSITION_GENERATOR_HEADER) | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $(POSITION_GENERATOR_SRC) -o $(POSITION_GENERATOR_OBJ)

$(MAIN_HORIZONTAL_OBJ): $(MAIN_HORIZONTAL_SRC) | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $(MAIN_HORIZONTAL_SRC) -o $(MAIN_HORIZONTAL_OBJ)

$(MAIN_CIRCULAR_OBJ): $(MAIN_CIRCULAR_SRC) | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $(MAIN_CIRCULAR_SRC) -o $(MAIN_CIRCULAR_OBJ)


clean:
	rm -f $(BUILD_DIR)/*.o $(BUILD_DIR)/*.d $(TARGET)

tests: $(ALL_BINS)

execute_tests: 
	./$(BIN_HORIZONTAL) && python3 $(SCRIPTS_DIR)/Plots_1source_1mic.py && python3 $(SCRIPTS_DIR)/Horizontal.py
	./$(BIN_CIRCULAR)   && python3 $(SCRIPTS_DIR)/Plots_1source_1mic.py && python3 $(SCRIPTS_DIR)/Circular.py
    
-include $(wildcard $(BUILD_DIR)/*.d)
