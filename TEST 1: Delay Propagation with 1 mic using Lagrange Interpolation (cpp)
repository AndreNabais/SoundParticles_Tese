struct Position {
    float x;
    float y;
    float z;
};

class Source {
    private:
    double Amplitude;
    double frequency;
    int SampleRate;
    int bufferSize;
    vector<Position> positions;
    vector<float> signal;

    public:
    //constructor
    Source(double amp, double freq, int sr, int bs, float initX, float initY, float initZ)
    : Amplitude(amp), frequency(freq), SampleRate(sr), bufferSize(bs) {
        signal.resize(bufferSize);
        positions.resize(bufferSize);
        for (int n=0; n<bufferSize; n++){
            signal[n] = Amplitude * sin(2.0 * M_PI * frequency * n / SampleRate);
            Position pos;
            pos = {initX, initY, initZ}; //for now, the source is static at the specified position
            positions[n] = pos;
        }
    }

    //getter for the signal buffer

    float getSignalSample(int n) const {
        return signal[n];
    }

    Position getPositionSample(int n) const {
        return positions[n];
    }

    double getSampleRate() const{
        return SampleRate;
    }

    double getBufferSize() const{
        return bufferSize;
    }
    
};



class Microphone{
    private:
        vector<Position> positions;
        vector<float> captured_signal;
        int bufferSize;

    public:
    Microphone(int bs, float initX, float initY, float initZ) : bufferSize(bs) {
        captured_signal.resize(bufferSize);
        positions.resize(bufferSize);
        for (int n=0; n<bufferSize; n++){
            Position pos;
            pos = {initX, initY, initZ}; //for now, the microphone is static at the specified position
            positions[n] = pos;
        }

    }

    void mic_capture(const Source& src) {
        for (int n = 0; n < bufferSize; n++) {
            captured_signal[n] = src.getSignalSample(n);
        }
    }

    //getter for the captured signal buffer
    float getCapturedSample(int n) const {
        return captured_signal[n];

    }

    Position getPositionSample(int n) const {
        return positions[n];
    }


void update_recv_sound(const vector<Source>& sources_vec, int current_sample) {

        captured_signal[current_sample] = 0.0f; // Inicializa o sample atual
        float c = 343.0f;          // Velocidade do som em m/s

        // Posição atual deste microfone no instante n
        Position mic_pos = getPositionSample(current_sample);

        for (const auto& source : sources_vec) {
            //Encontrar a posição desta fonte específica no instante n


            for (int i = current_sample; i >= 0; i--){
                Position src_pos = source.getPositionSample(i);
                float dx = mic_pos.x - source.getPositionSample(i).x;
                float dy = mic_pos.y - source.getPositionSample(i).y;
                float dz = mic_pos.z - source.getPositionSample(i).z;
                float distance = sqrt(dx*dx + dy*dy + dz*dz);
                
                float time_in_current_sample = static_cast<float>(current_sample) / static_cast<float>(source.getSampleRate());
                float time_in_i_sample = static_cast<float>(i) / static_cast<float>(source.getSampleRate());
                float delay_samples = static_cast<float>((distance / c) * source.getSampleRate());
                float time_diff = time_in_current_sample - time_in_i_sample;

                float result = time_diff * c - distance;
                if (result >= 0) {

                    //lagrange interpolation for mic
                    float n_float = static_cast<float>(current_sample) - delay_samples;
                    int M = static_cast<int>(floor(n_float));
                    int N = 3; //cubic interpolation with 4 points
                    int start_index = M - (N / 2); //center the interpolation around M

                    if (start_index >= 0 && (start_index + N) < source.getBufferSize()) {
                        float y_lagrange = 0.0; // This is our summation result y(x)

                        //summation loop for Lagrange interpolation
                        for (int k=0; k<=N; k++){
                            int current_k_sample = start_index + k; //this is the sample index for the current k in the summation loop, which corresponds to x_k in the Lagrange interpolation formula

                            float l_k = 1.0; // This is the product term l_k(x) 

                            //product loop for Lagrange interpolation
                            for (int j=0; j<=N; j++){
                                if (j != k) { //we skip the case where j=k in the product term
                                    int current_j_sample = start_index + j; //this is the sample index for the current j in the product loop, which corresponds to x_j in the Lagrange interpolation formula
                                    float numerator = n_float - static_cast<float>(current_j_sample);
                                    float denominator = static_cast<float>(current_k_sample) - static_cast<float>(current_j_sample);
                
                                    l_k *= (numerator / denominator);
                                    }

                                }

                            y_lagrange += source.getSignalSample(current_k_sample) * l_k; 

                            }
                        
                        captured_signal[current_sample] += y_lagrange;
                    }

                    else {
                        if (M >= 0 && M < source.getBufferSize()) {
                        // Not enough room for 4-point cubic, downgrade smoothly to Nearest Neighbor
                            captured_signal[current_sample] += source.getSignalSample(M);
                        } else if (M < 0) {
                            // Extreme start boundary
                            captured_signal[current_sample] += source.getSignalSample(0);
                        } else {
                            // Extreme end boundary
                            captured_signal[current_sample] += source.getSignalSample(source.getBufferSize() - 1);
                        }
                    }


                    if (current_sample % 500 == 0) {
                    
                    cout << "Mic Sample: " << current_sample 
                        << " | Source Sample: " << i 
                        << " | Delay: " << delay_samples << " samples" << endl;
                }

                    break; // Saímos do loop, pois os samples anteriores a i não terão tempo de chegar ao microfone no instante current_sample
                }
        

            }
        }
    }
};



int main(){

    // Record start time
    auto start = std::chrono::high_resolution_clock::now();


    vector <Source> sources_vec;
    int bufferSize = 2048;
    //start with 1 source
    for (int i = 0; i < 1; ++i) {
        sources_vec.push_back(Source(0.5, 440.0, 44100, bufferSize, .0, 0, 0));
    }


    vector<Microphone> mic_vec; //start with 1 microphone
    for (int i = 0; i < 1; ++i) {
        mic_vec.push_back(Microphone(bufferSize, 1.0f, 0.0f, 0.0f)); //initialize each microphone at position (1,0,0)
    }

    for (int i = 0; i < bufferSize; ++i) {
        for (int j = 0; j < 1; ++j) {
            mic_vec[j].update_recv_sound(sources_vec, i);
        }        

    }
    //mic.mic_capture(src); //capture the signal
    

    //save csv files

    ofstream src_file("./source.csv");
        for (size_t i = 0; i < bufferSize; ++i) {
            float time_source = static_cast<float>(i)/static_cast<float>(sources_vec[0].getSampleRate());
            src_file << time_source << "," << sources_vec[0].getSignalSample(i) << "\n";
            };
    src_file.close();


    ofstream mic_file("./microphone1.csv");
        for (size_t i = 0; i < bufferSize; ++i) {
            float time_mic = static_cast<float>(i)/static_cast<float>(sources_vec[0].getSampleRate());
            mic_file << time_mic << "," << mic_vec[0].getCapturedSample(i) << "\n";
            };
    mic_file.close();

    cout << "Saved all CSVs in: " << filesystem::current_path() << endl;
    
    // Record end time
    auto finish = std::chrono::high_resolution_clock::now();

    // Calculate duration
    // Use microseconds (us) if the code runs very fast, or milliseconds (ms) for longer simulations
    auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(finish - start);

    cout << "Execution time: " << duration.count() << " milliseconds" << endl;
    return 0;
    }
